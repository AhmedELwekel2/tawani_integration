# Dependencies
node_modules/
backend/node_modules/

# Build outputs
dist/
backend/dist/
build/

# Environment variables
# NOTE: .env itself is intentionally tracked (see commit 914b191) -- it holds only
# the Supabase URL and the *publishable* key, both of which ship in the client
# bundle anyway. Local overrides must never be committed, and no secret
# (service-role key, SMTP password, API token) belongs in any of these files.
.env.local
.env.*.local
.worktrees/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo

# Testing
coverage/
