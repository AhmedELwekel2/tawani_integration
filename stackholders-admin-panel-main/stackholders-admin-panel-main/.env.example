# Copy to .env.local to override locally (.env is tracked and holds the shared
# defaults). Everything here is compiled into the client bundle by Vite, so it
# must contain nothing secret.
#
# NEVER put SUPABASE_SERVICE_ROLE_KEY (or any other secret) in this file. Work
# that needs service-role privileges belongs in a Supabase Edge Function, which
# reads its keys from the function environment -- see the `admin-portal-users`
# function for the pattern.

# Supabase project URL.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable ("sb_publishable_...") or legacy anon key. Client-safe by design:
# all authorisation is enforced by RLS and by is_portal_admin() in Postgres.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Optional: local dev server port (vite.config.ts defaults to 3001).
PORT=5173

# Optional: used only for local tooling/links.
FRONTEND_URL=http://localhost

# Tawani tourism news agent (FastAPI). See --main/README.md
VITE_TAWANI_API_URL=http://127.0.0.1:8010
