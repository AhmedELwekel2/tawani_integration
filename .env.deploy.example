# Build/run configuration for docker-compose.yml.  Copy to .env and fill in.
# Both apps normally point at the same Supabase project.

PORTAL_SUPABASE_URL=https://<project-ref>.supabase.co
PORTAL_SUPABASE_ANON_KEY=<publishable-or-anon-key>

ADMIN_SUPABASE_URL=https://<project-ref>.supabase.co
ADMIN_SUPABASE_ANON_KEY=<publishable-or-anon-key>

# These two are halves of one handshake and MUST agree: the agent demands
# TAWANI_ADMIN_KEY, and ADMIN_TAWANI_KEY is what gets compiled into the admin
# bundle to send. Setting only the first makes every report generation 401.
#
# Leave BOTH empty. Anything VITE_* is readable in the public JS bundle, so the
# key protects nothing nginx is not already protecting -- the admin vhost is the
# only place /tawani/ mutations are reachable.
TAWANI_ADMIN_KEY=
ADMIN_TAWANI_KEY=
