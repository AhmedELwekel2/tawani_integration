# Build/run configuration for docker-compose.yml.  Copy to .env and fill in.
# Both apps normally point at the same Supabase project.

PORTAL_SUPABASE_URL=https://<project-ref>.supabase.co
PORTAL_SUPABASE_ANON_KEY=<publishable-or-anon-key>

ADMIN_SUPABASE_URL=https://<project-ref>.supabase.co
ADMIN_SUPABASE_ANON_KEY=<publishable-or-anon-key>

# Runtime guard on the agent's generate/publish routes.
TAWANI_ADMIN_KEY=<long-random-string>

# Leave EMPTY. Anything VITE_* is compiled into the public JS bundle, so setting
# this publishes the key above to every visitor. The admin vhost restricting
# /tawani/ is the real control.
ADMIN_TAWANI_KEY=
