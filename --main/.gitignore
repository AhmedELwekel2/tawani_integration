# Reference copy of the previous tourism bot. Kept locally for its templates and
# fonts, never committed: it holds hardcoded Telegram/Twitter/Bedrock tokens.
tourism_bot/

# SQLite WAL sidecars — they hold live database content (incl. password
# hashes) until checkpointed. Never commit them.
*.db-wal
*.db-shm

# Local report store (the agent owns its own data)
quality_bot/tawani.db
quality_bot/tawani.db-wal
quality_bot/tawani.db-shm
